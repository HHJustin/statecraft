# L1 检索黄金集：query + corpus（候选记忆）+ relevant（相关条目下标）
# 用法：重建内存记忆 → add corpus → search(query, k=5) → Recall@K / MRR
# 后两条是「改述样本」：query 与相关条目用词不同（数据库 vs DB、生产环境 vs 线上），
# 词面检索召回不了，dense 向量（配同义词扩展）可以 —— 用于量化混合检索的增益
{"query": "周报有什么格式要求", "corpus": ["团队约定：周报必须包含数据来源与风险提示", "今天天气晴朗适合郊游", "周三例会讨论了版本发布计划"], "relevant": [0]}
{"query": "上线前要做什么准备", "corpus": ["上线前需完成回归测试与数据备份", "周报模板已更新到新版本", "食堂菜单本周新增了川菜"], "relevant": [0]}
{"query": "数据来源 有什么要求", "corpus": ["周报必须包含数据来源", "风险提示需要量化影响面", "数据来源必须可追溯到原始报表"], "relevant": [0, 2]}
{"query": "数据库连不上怎么排查", "corpus": ["DB 连接池耗尽时要先查配置和重试策略", "今天团建吃火锅", "周报模板已更新"], "relevant": [0]}
{"query": "生产环境的上线流程是什么", "corpus": ["线上发布必须走灰度并准备回滚预案", "食堂菜单本周新增了川菜", "注释规范 v2 已发布"], "relevant": [0]}
